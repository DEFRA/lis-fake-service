{
  "name": "@livestock/fake-service",
  "version": "0.0.1",
  "description": "Fakes upstream identity/data dependencies (DEFRA CI, Entra ID, and eventually others) for local and CDP dev environments",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:frontend": "NODE_ENV=production vite build",
    "build:frontend:watch": "vite build --watch",
    "dev": "run-p build:frontend:watch server:watch",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json}\"",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "pretest": "npm run build:frontend",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "server:watch": "nodemon --ext js,json --legacy-watch ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node --use-strict .",
    "prepare": "if [ ! \"$CI\" ]; then husky; fi",
    "security-audit": "audit-ci",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "^7.1.2",
    "@hapi/vision": "7.0.3",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "fast-xml-parser": "^5.10.1",
    "govuk-frontend": "^6.3.0",
    "hapi-pino": "13.0.0",
    "libxmljs2": "^0.37.0",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@defra/lis-infra-eslint-config": "0.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.5.2",
    "cheerio": "1.2.0",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "^3.8.4",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.0",
    "stylelint-config-gds": "^3.0.0",
    "vite": "^8.1.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tmp": "0.2.5"
  }
}
