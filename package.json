{
  "name": "@defra/fake-service",
  "version": "0.0.1",
  "description": "Fakes upstream data dependencies (CTS, identity-service-helper) for local and CDP dev environments",
  "main": "src/index.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "run-p server:watch",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json}\"",
    "lint": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "server:watch": "nodemon --ext js,json --legacy-watch ./src",
    "start": "NODE_ENV=production node --use-strict .",
    "prepare": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "security-audit": "audit-ci",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/hapi": "21.4.10",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "fast-xml-parser": "^5.10.1",
    "hapi-pino": "13.0.0",
    "libxmljs2": "^0.37.0",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@defra/lis-infra-eslint-config": "^0.6.0",
    "@vitest/coverage-v8": "^4.1.9",
    "audit-ci": "^7.1.0",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "^3.8.4",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tmp": "0.2.5"
  }
}
