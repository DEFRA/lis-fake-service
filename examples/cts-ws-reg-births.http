### FAILURE - submit (7 rows: only row 7 accepted, rows 1-6 rejected)
< {%
  request.variables.set("data", btoa(
    '<?xml version="1.0" encoding="utf-8"?>' +
    '<RegBirths xmlns="http://defra.bcms.ctws/register_births_request" SchemaVersion="1.0" ProgramName="CTWSProg" ProgramVersion="1b" RequestTimeStamp="2026-01-01T00:00:00Z">' +
      '<Authentication><CTS_OL_User xmlns="" Usr="dev-cts-usr" Pwd="dev-cts-pass123"/></Authentication>' +
      '<Births TxnId="reg-births-failure-example">' +
        '<Birth RowNum="1" Etg="UK12345"        Dob="2026-01-01" Brd="HF" Sex="f" GdEtg="UK200000000007" BLoc="22/001/0001" PLoc="22/001/0001" IWarn="n"/>' +
        '<Birth RowNum="2" Etg="UK100000000006" Dob="2026-01-01" Brd="ZZ" Sex="f" GdEtg="UK200000000007" BLoc="22/001/0001" PLoc="22/001/0001" IWarn="n"/>' +
        '<Birth RowNum="3" Etg="UK500000000001" Dob="2026-01-01" Brd="HF" Sex="f" GdEtg="UK200000000007" BLoc="22/001/0001" PLoc="22/001/0001" IWarn="n"/>' +
        '<Birth RowNum="4" Etg="UK200000000001" Dob="2026-01-01" Brd="HF" Sex="f" GdEtg="UK200000000007" BLoc="22/001/0001" PLoc="22/001/0001" IWarn="n"/>' +
        '<Birth RowNum="5" Etg="UK100000000007" Dob="2026-01-01" Brd="HF" Sex="f" GdEtg="UK999999999999" BLoc="22/001/0001" PLoc="22/001/0001" IWarn="n"/>' +
        '<Birth RowNum="6" Etg="UK100000000008" Dob="2026-06-01" Brd="HF" Sex="f" GdEtg="UK300000000001" BLoc="22/001/0001" PLoc="22/001/0001" IWarn="n"/>' +
        '<Birth RowNum="7" Etg="UK100000000009" Dob="2026-01-01" Brd="HF" Sex="f" GdEtg="UK200000000007" BLoc="22/001/0001" PLoc="22/001/0001" IWarn="n"/>' +
      '</Births>' +
    '</RegBirths>'
  ));
%}
