<BirthResults xmlns="http://defra.bcms.ctws/register_births_request_results" SchemaVersion="{{ schemaVersion }}" ProgramName="{{ programName }}" ProgramVersion="{{ programVersion }}" ResponseTimeStamp="{{ responseTimeStamp }}"><Results TxnId="{{ txnId }}">{% if accepted.length %}<Accepted>{% for rowNum in accepted %}<Accept RowNum="{{ rowNum }}"/>{% endfor %}</Accepted>{% endif %}{% if rejected.length %}<Rejected>{% for reject in rejected %}<Reject><Birth {% for key, value in reject.attributes %}{{ key }}="{{ value }}" {% endfor %}/><Causes>{% for cause in reject.causes %}<Cause Code="{{ cause.code }}" Desc="{{ cause.desc }}" Sev="{{ cause.sev }}" Field="{{ cause.field }}"/>{% endfor %}</Causes></Reject>{% endfor %}</Rejected>{% endif %}</Results></BirthResults>
